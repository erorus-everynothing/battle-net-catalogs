  "strings": {
    "deDE": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Editor starten",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Die Kampagnensammlung ist im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben. Für den Zugriff auf die zusätzlichen Inhalte der Digital Deluxe Edition ist ein separater Kauf erforderlich.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Öffentlicher Testrealm (PTR)"
    },
    "default": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Launch Editor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Campaign Collection is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Access to the Digital Deluxe items requires a separate purchase.",
      "starcraft_ii#S2_NAME": "StarCraft II",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Public Test Realm"
    },
    "esES": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Iniciar Editor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "La Colección de campañas se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox. El acceso a los artículos de la Edición Digital Deluxe se vende por separado.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Reino público de pruebas"
    },
    "esMX": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Ejecutar editor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "La Saga Completa se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox. El acceso a los elementos de la Edición Digital Deluxe requiere una compra por separado.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Reino público de pruebas"
    },
    "frFR": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Lancer l’éditeur",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "La Collection de campagnes est incluse dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox. Les éléments de l’Édition Digital Deluxe devront être achetés séparément.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Royaume public de test"
    },
    "itIT": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Editor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "L'Edizione Campagne è inclusa in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox. L'accesso agli oggetti dell'Edizione digitale deluxe richiede un acquisto separato.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Reame pubblico di prova"
    },
    "jaJP": {
      "starcraft_ii#QUICK_LINK_EDITOR": "エディターを起動",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「Campaign Collection」をXbox Game Passでお楽しみいただけます。なお、デジタルデラックスのアイテムをご利用いただくには、別途購入が必要です。",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "パブリックテストサーバー"
    },
    "koKR": {
      "starcraft_ii#QUICK_LINK_EDITOR": "편집기 실행",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「Campaign Collection」をXbox Game Passでお楽しみいただけます。なお、デジタルデラックスのアイテムをご利用いただくには、別途購入が必要です。",
      "starcraft_ii#S2_NAME": "스타크래프트 II",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "공개 테스트 서버"
    },
    "plPL": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Uruchom Edytor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Kolekcja kampanii jest dostępna w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox. Dostęp do przedmiotów z Edycji Cyfrowej Deluxe wymaga osobnego zakupu.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Publiczny Serwer Testowy"
    },
    "ptBR": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Iniciar Editor",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "A Saga Completa está inclusa no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox. O acesso aos itens da Edição Digital Deluxe exige uma compra separada.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Reino de Teste Público"
    },
    "ruRU": {
      "starcraft_ii#QUICK_LINK_EDITOR": "Запуск редактора",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Сюжетная коллекция доступна активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox. Доступ к предметам издания Digital Deluxe приобретается отдельно.",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "Тестовый игровой мир (PTR)"
    },
    "thTH": {
      "starcraft_ii#QUICK_LINK_EDITOR": "เปิดตัวแก้ไข",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "Campaign Collection จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox สิทธิ์รับรายการต่างๆ ใน Digital Deluxe ต้องซื้อแยกต่างหาก",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "เซิร์ฟเวอร์ทดสอบสาธารณะ (PTR)"
    },
    "zhCN": {
      "starcraft_ii#QUICK_LINK_EDITOR": "启动编辑器",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩《Campaign Collection》。数字豪华版物品需另行购买才能解锁。",
      "starcraft_ii#S2_NAME": "星际争霸II",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "公共测试服"
    },
    "zhTW": {
      "starcraft_ii#QUICK_LINK_EDITOR": "啟動編輯器",
      "starcraft_ii#S2_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩劇情戰役組合包。若要取得數位豪華版物品，則需另外購買。",
      "starcraft_ii#S2_NAME": "《星海爭霸II》",
      "starcraft_ii#S2_PTR_DISPLAY_STRING": "測試伺服器"
    }
