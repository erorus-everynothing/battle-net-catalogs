  "strings": {
    "deDE": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time ist im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben."
    },
    "default": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It’s About Time is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account.",
      "wlby#WLBY_NAME": "Crash Bandicoot 4: It's About Time",
      "wlby#WLBY_NAME_SHORT": "Crash Bandicoot 4"
    },
    "esES": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox."
    },
    "esMX": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox."
    },
    "frFR": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It’s About Time est inclus dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox."
    },
    "itIT": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time è incluso in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox."
    },
    "jaJP": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「クラッシュ・バンディクー4 とんでもマルチバース」をXbox Game Passでお楽しみいただけます。",
      "wlby#WLBY_NAME": "クラッシュ・バンディクー4:とんでもマルチバース"
    },
    "koKR": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다."
    },
    "plPL": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It’s About Time jest dostępny w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox.",
      "wlby#WLBY_NAME": "Crash Bandicoot 4: Najwyższy Czas"
    },
    "ptBR": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It’s About Time está incluso no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox."
    },
    "ruRU": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Игра «Crash Bandicoot 4: Это вопрос времени» доступна активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox.",
      "wlby#WLBY_NAME": "Crash Bandicoot 4: Это вопрос времени"
    },
    "thTH": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "Crash Bandicoot 4: It's About Time จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox"
    },
    "zhCN": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩《Crash Bandicoot 4: It’s About Time》。"
    },
    "zhTW": {
      "wlby#WLBY_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩《Crash Bandicoot 4: It's About Time》。"
    }
  },
