  "strings": {
    "deDE": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Die Base Edition und die Erweiterung „Reaper of Souls“ sind für aktive Nutzer mit einem gültigen Abonnement, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben, im Xbox Game Pass enthalten. Der Zugang zur Erweiterung „Rückkehr des Totenbeschwörers“ muss separat erworben werden.",
      "diablo_iii#D3_PTR_NAME": "Öffentlicher Testrealm (PTR)",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "Die Diablo® III Starter Edition ermöglicht es, das Spiel bis zum Skelettkönig in Akt I kostenlos auszuprobieren."
    },
    "default": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Base Edition and Reaper of Souls Expansion are included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Access to Rise of the Necromancer Expansion requires a separate purchase.",
      "diablo_iii#D3_NAME": "Diablo III",
      "diablo_iii#D3_PTR_NAME": "Public Test Realm",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "The Diablo® III Starter Edition allows players to try it for free up to the Skeleton King in Act I"
    },
    "esES": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "El juego base y la expansión Reaper of Souls están incluidas en Xbox Game Pass para los usuarios activos con una suscripción compatible que hayan vinculado sus cuentas de Battle.net y de Xbox. El acceso a la expansión Despertar del Nigromante se compra por separado.",
      "diablo_iii#D3_PTR_NAME": "Reino público de pruebas",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "La Starter Edition de Diablo® III permite a los jugadores probar de manera gratuita hasta el Rey Esqueleto del Acto I."
    },
    "esMX": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "La edición base y la expansión Reaper of Souls vienen incluidas con Xbox Game Pass para los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox. El acceso a la expansión Ascenso del Nigromante requiere una compra por separado.",
      "diablo_iii#D3_PTR_NAME": "Reino público de pruebas",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "La edición Starter Edition de Diablo® III permite que los jugadores disfruten del juego de forma gratuita hasta el Rey Esqueleto del Acto I."
    },
    "frFR": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "L’édition de base et l’extension Reaper of Souls sont comprises dans le Xbox Game Pass pour les utilisatrices et utilisateurs actifs disposant d’un abonnement valide et ayant associé leur compte Battle.net à leur compte Xbox. Un achat séparé est nécessaire pour accéder à l’extension Le retour du nécromancien.",
      "diablo_iii#D3_PTR_NAME": "Royaume public de test",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "L’édition Découverte de Diablo® III permet aux joueurs et joueuses d’essayer le jeu gratuitement jusqu’au roi squelette de l’acte I."
    },
    "itIT": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "L'edizione base e l'espansione Reaper of Souls sono incluse con Xbox Game Pass per gli abbonati con un piano idoneo che hanno collegato il proprio account Battle.net a quello Xbox. L'accesso all'espansione Ascesa del Negromante richiede un acquisto separato.",
      "diablo_iii#D3_PTR_NAME": "Reame pubblico di prova",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "Con la Starter Edition di Diablo® III è possibile provare gratuitamente il gioco fino al Re Scheletro dell'Atto I"
    },
    "jaJP": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Xbox Game Passに現在加入していて、かつBattle.netアカウントとXboxアカウントをリンクしている方は、ゲーム本編と拡張パック「Reaper of Souls」をXbox Game Passのコンテンツとしてプレイできます。拡張パック「Rise of the Necromancer」にアクセスするには、個別に購入する必要があります。",
      "diablo_iii#D3_PTR_NAME": "パブリックテストサーバー",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "「ディアブロ III」のスターターエディションでは、プレイヤーはAct Iの骸骨王まで無料でお試し可能です"
    },
    "koKR": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "유효한 구독 상품을 유지 중이며 Battle.net 계정을 Xbox 계정에 연결하여 이용 중인 사용자의 경우, Xbox Game Pass에 기본판과 영혼을 거두는 자 확장팩이 포함되어 있습니다. 강령술사의 귀환 확장팩을 이용하려면 별도 구매가 필요합니다.",
      "diablo_iii#D3_NAME": "디아블로 III",
      "diablo_iii#D3_PTR_NAME": "공개 테스트 서버",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "디아블로® III 처음 사용자용 버전에 접속하면 1막의 해골왕까지 무료로 플레이하실 수 있습니다"
    },
    "plPL": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Edycja podstawowa i dodatek Reaper of Souls są uwzględnione w subskrypcji Xbox Game Pass dla aktywnych użytkowników, którzy wykupili kwalifikującą się subskrypcję i powiązali konto Battle.net z kontem Xbox. Aby uzyskać dostęp do pakietu Przebudzenie Nekromantów, należy dokonać osobnego zakupu.",
      "diablo_iii#D3_PTR_NAME": "Publiczny Serwer Testowy",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "Starter Diablo® III pozwala wypróbować grę bezpłatnie do spotkania z Królem Szkieletów w Akcie I"
    },
    "ptBR": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "A Edição Base e a expansão Reaper of Souls estão incluídas no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua conta Battle.net à conta Xbox. O acesso à expansão Ascensão do Necromante é vendido separadamente.",
      "diablo_iii#D3_PTR_NAME": "Reino de Teste Público",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "Diablo® III: Starter Edition permite que os jogadores testem o jogo gratuitamente até o Rei Esqueleto no Ato I."
    },
    "ruRU": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Издание Base Edition и дополнение Reaper of Souls доступны владельцам действующей подписки Xbox Game Pass, объединившим учетные записи Battle.net и Xbox. Комплект «Возвращение некроманта» приобретается отдельно.",
      "diablo_iii#D3_PTR_NAME": "Тестовый игровой мир (PTR)",
      "diablo_iii#D3_STARTER_TOOLTIP_REMARK": "Стартовая версия Diablo® III позволяет играть бесплатно до сражения с Королем-скелетом в Акте I."
    },
    "thTH": {
      "diablo_iii#D3_GAME_PASS_DISCLAIMER": "Base Edition และส่วนเสริม Reaper of Souls รวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่มีการสมัครสมาชิกที่ร่วมรายการและเชื่อมโยงบัญชี Battle.net เข้ากับบัญชี Xbox ในขณะที่ส่วนเสริม Rise of the Necromancer ต้องซื้อแยกต่างหากถึงเล่นได้",
