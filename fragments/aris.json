  "strings": {
    "deDE": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Die Standard Edition und der Skin „Leeren-DOOM-Slayer“ sind im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben. Für den Zugriff auf die zusätzlichen Inhalte der Premium Edition ist ein separater Kauf erforderlich."
    },
    "default": {
      "aris#ARIS_ARTBOOK_NAME": "DOOM: The Dark Ages Digital Artbook and Original Soundtrack",
      "aris#ARIS_ARTBOOK_NAME_DEV": "Artbook Dev",
      "aris#ARIS_ARTBOOK_NAME_RC": "Artbook RC",
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Standard Edition and Void DOOM Slayer Skin are included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Access to Premium Edition items requires a separate purchase.",
      "aris#ARIS_NAME": "Doom: The Dark Ages",
      "aris#ARIS_NAME_RC": "Aries RC"
    },
    "esES": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "La Edición Estándar y el aspecto DOOM Slayer del Vacío se incluyen en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox. El acceso a los artículos de la Edición Prémium se vende por separado."
    },
    "esMX": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "La Edición Estándar y el diseño de DOOM Slayer del vacío se incluyen en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox. El acceso a los elementos de la Edición Prémium requiere una compra por separado."
    },
    "frFR": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "L’Édition Standard et l’apparence Void pour le DOOM Slayer sont incluses dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox. Les éléments de l’Édition Premium devront être achetés séparément"
    },
    "itIT": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "La Standard Edition e la skin DOOM Slayer Vuoto sono incluse in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox. L'accesso agli oggetti della Premium Edition richiede un acquisto separato."
    },
    "jaJP": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、スタンダードエディションとドゥームスレイヤースキン「ヴォイド」をXbox Game Passでお楽しみいただけます。なお、プレミアムエディションのアイテムをご利用いただくには、別途購入が必要です。"
    },
    "koKR": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "스탠다드 에디션과 공허 둠 슬레이어 스킨은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다. 프리미엄 에디션 아이템을 이용하려면 별도 구매가 필요합니다."
    },
    "plPL": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Edycja Standardowa i skórka pustki dla DOOM Slayera są dostępne w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox. Dostęp do przedmiotów z Edycji Premium wymaga osobnego zakupu."
    },
    "ptBR": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "A Edição Padrão e o Visual DOOM Slayer do Vazio estão inclusos no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox. O acesso aos itens da Edição Premium exige uma compra separada."
    },
    "ruRU": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Стандартное издание и облик Палача Рока «Пустота» доступны активным пользователям Xbox Game Pass, связавшим Battle.net с учетной записью сети Xbox. Доступ к предметам премиум-издания приобретается отдельно."
    },
    "thTH": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "Standard Edition และสกิน Void DOOM Slayer จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox สิทธิ์รับรายการต่างๆ ใน Premium Edition ต้องซื้อแยกต่างหาก"
    },
    "zhCN": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩标准版并获得虚空毁灭战士皮肤。高级版物品需另行购买才能解锁。"
    },
    "zhTW": {
      "aris#ARIS_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩標準版並獲得虛空毀滅戰士造型。若要取得高級版物品，則需另外購買。"
    }
  },
