      "heroes#HEROES_PTR_DISPLAY_NAME": "Public Test Realm"
    },
    "esES": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "El pack de refuerzo heroico se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Reino público de pruebas"
    },
    "esMX": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "El Paquete heroico Refuerzos se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Reino público de pruebas"
    },
    "frFR": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Le pack Renforts héroïques est inclus dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Royaume public de test"
