    "ruRU": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Комплект «Героическое подкрепление» доступен активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Тестовый игровой мир (PTR)"
