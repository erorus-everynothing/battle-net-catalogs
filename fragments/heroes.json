    "itIT": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Il Pacchetto Rinforzi Eroici è incluso in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Reame pubblico di prova"
    },
    "jaJP": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「Heroic Reinforcement Bundle」をXbox Game Passでお楽しみいただけます。",
      "heroes#HEROES_PTR_DISPLAY_NAME": "パブリックテストサーバー"
    },
    "koKR": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "지원군 묶음 상품은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다.",
      "heroes#HEROES_NAME": "히어로즈 오브 더 스톰",
      "heroes#HEROES_PTR_DISPLAY_NAME": "공개 테스트 서버"
    },
    "plPL": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Zestaw: Heroiczne posiłki jest dostępny w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Publiczny Serwer Testowy"
    },
    "ptBR": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "O Pacote Reforço Heroico está incluso no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox.",
