  "strings": {
    "deDE": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "Das Sparpaket: Heldenhafte Verstärkung ist im Xbox Game Pass für aktive Mitglieder mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben.",
      "heroes#HEROES_PTR_DISPLAY_NAME": "Öffentlicher Testrealm (PTR)"
    },
    "default": {
      "heroes#HEROES_GAME_PASS_DISCLAIMER": "The Heroic Reinforcement Bundle is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account.",
