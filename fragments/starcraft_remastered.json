  "strings": {
    "deDE": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Das Grundspiel ist im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben. Für das Add-on „Cartooned“ ist ein separater Kauf erforderlich.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Öffentlicher Testrealm (PTR)",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "Die kostenlose Version hat Originalgrafik und -ton."
    },
    "default": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Base game is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Cartooned add-on requires a separate purchase.",
      "starcraft_remastered#S1_NAME": "StarCraft",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Public Test Realm",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "Free version comes with original graphics and audio"
    },
    "esES": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "El juego base se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox. El complemento de Dibujos animados se vende por separado.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Reino público de pruebas",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "La versión gratuita incluye gráficos y sonido originales."
    },
    "esMX": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "El juego base se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox. El complemento Cartooned requiere una compra por separado.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Reino público de pruebas",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "La versión gratuita trae gráficos y audios originales"
    },
    "frFR": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Le jeu de base est inclus dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox. Les extensions Cartooned devront être achetées séparément.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Royaume public de test",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "La version gratuite comprend les graphismes et l’audio d’origine."
    },
    "itIT": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Il gioco base è incluso in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox. Il contenuto aggiuntivo Cartooned richiede un acquisto separato.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Reame pubblico di prova",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "La versione gratuita include grafica e audio originali"
    },
    "jaJP": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、ベースゲームをXbox Game Passでお楽しみいただけます。なお、「Cartooned」アドオンをご利用いただくには、別途購入が必要です。",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "パブリックテストサーバー",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "無料版は、独自のグラフィックとオーディオで構成されています"
    },
    "koKR": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "기본 게임은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다. 카툰 추가 콘텐츠는 별도 구매가 필요합니다.",
      "starcraft_remastered#S1_NAME": "스타크래프트",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "공개 테스트 서버",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "무료 버전은 원본 그래픽과 오디오와 함께 제공됩니다"
    },
    "plPL": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Gra podstawowa jest dostępna w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox. Dodatek Cartooned wymaga osobnego zakupu.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Publiczny Serwer Testowy",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "Bezpłatna wersja zawiera oryginalną grafikę i dźwięk"
    },
    "ptBR": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "O jogo base está incluso no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox. A expansão Cartooned exige uma compra separada.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Reino de Teste Público",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "A versão gratuita possui os gráficos e áudio originais"
    },
    "ruRU": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "Основная игра доступна активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox. Дополнение «Мультяшки» приобретается отдельно.",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "Тестовый игровой мир (PTR)",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "Бесплатная версия содержит оригинальную графику и звуковое сопровождение."
    },
    "thTH": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "ตัวเกมหลักจะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox ส่วนเสริมการ์ตูนต้องซื้อแยกต่างหาก",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "เซิร์ฟเวอร์ทดสอบสาธารณะ (PTR)",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "เวอร์ชันฟรีมาพร้อมกับกราฟิกและเสียงแบบดั้งเดิม"
    },
    "zhCN": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩基础游戏。重制版追加内容需另行购买。",
      "starcraft_remastered#S1_NAME": "星际争霸：重制版",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "公共测试服",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "免费版本配备原版图像和音效。"
    },
    "zhTW": {
      "starcraft_remastered#S1_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩基礎遊戲。卡通版追加內容需要另外購買。",
      "starcraft_remastered#S1_NAME": "《星海爭霸》",
      "starcraft_remastered#S1_PTR_DISPLAY_NAME": "測試伺服器",
      "starcraft_remastered#S1_STARTER_TOOLTIP_REMARK": "免費版帶有原版畫質及音效"
    }
  },
