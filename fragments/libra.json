  "strings": {
    "deDE": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 – Demo",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Die Standard Edition ist im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben. Für den Zugriff auf die zusätzlichen Inhalte der Deluxe Edition ist ein separater Kauf erforderlich."
    },
    "default": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 – Demo",
      "libra#LBRA_DEMO_RC": "Tony Hawk's Pro Skater 3+4 - Demo RC",
      "libra#LBRA_FOUNDRY_DEMO_DEV_1": "Foundry Demo Developer-1",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Standard Edition is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Access to Digital Deluxe Edition items requires a separate purchase.",
      "libra#LBRA_NAME": "Tony Hawk's™ Pro Skater™ 3 + 4"
    },
    "esES": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 – Demo",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "La Edición Estándar se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox. El acceso a los artículos de la Edición Digital Deluxe se vende por separado."
    },
    "esMX": {
      "libra#LBRA_DEMO": "Demo de Tony Hawk's™ Pro Skater™ 3 + 4",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "La Edición Estándar se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox. El acceso a los elementos de la Edición Digital Deluxe requiere una compra por separado."
    },
    "frFR": {
      "libra#LBRA_DEMO": "Tony Hawk’s™ Pro Skater™ 3 + 4 – Démo",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "L’Édition Standard est incluse dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox. L’Édition Digital Deluxe devra être achetée séparément."
    },
    "itIT": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 - Demo",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "L'Edizione Standard è inclusa in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox. L'accesso agli oggetti dell'Edizione Digitale Deluxe richiede un acquisto separato."
    },
    "jaJP": {
      "libra#LBRA_DEMO": "トニー・ホーク™ プロ・スケーター™ 3+4 – 体験版",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、スタンダードエディションをXbox Game Passでお楽しみいただけます。なお、デジタルデラックスエディションのアイテムをご利用いただくには、別途購入が必要です。",
      "libra#LBRA_NAME": "トニー・ホーク™ プロ・スケーター™ 3+4"
    },
    "koKR": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 - 데모",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "스탠다드 에디션은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다. 디지털 디럭스 에디션 아이템을 이용하려면 별도 구매가 필요합니다."
    },
    "plPL": {
      "libra#LBRA_DEMO": "Tony Hawk’s™ Pro Skater™ 3 + 4 – wersja demonstracyjna",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Edycja Standardowa jest dostępna w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox. Dostęp do przedmiotów z Edycji Cyfrowej Deluxe wymaga osobnego zakupu."
    },
    "ptBR": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 – Demo",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "A Edição Padrão está inclusa no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox. O acesso aos itens da Edição Digital Deluxe exige uma compra separada."
    },
    "ruRU": {
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Стандартное издание доступно активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox. Издание Digital Deluxe приобретается отдельно."
    },
    "thTH": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater™ 3 + 4 – เดโม",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "Standard Edition จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox สิทธิ์รับรายการต่างๆ ใน Digital Deluxe Edition ต้องซื้อแยกต่างหาก"
    },
    "zhCN": {
      "libra#LBRA_DEMO": "Tony Hawk's™ Pro Skater 3 + 4 - 试玩版",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩标准版。数字豪华版物品需另行购买才能解锁。"
    },
    "zhTW": {
      "libra#LBRA_DEMO": "《Tony Hawk's™ Pro Skater™ 3 + 4》：試玩版",
      "libra#LBRA_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩標準版。若要取得數位豪華版物品，則需另外購買。"
    }
  },
