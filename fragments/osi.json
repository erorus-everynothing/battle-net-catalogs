  "strings": {
    "deDE": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Die Base Edition ist im Xbox Game Pass für aktive Benutzer mit gültigem Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Account verknüpft haben. Für Reign of the Warlock ist ein separater Kauf erforderlich.",
      "osi#OSI_PTR_NAME": "Öffentlicher Testrealm (PTR)"
    },
    "default": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Base Edition is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account. Access to Reign of the Warlock requires a separate purchase.",
      "osi#OSI_NAME": "Diablo II: Resurrected",
      "osi#OSI_NAME_REVIEW": "D2R: Early Review",
      "osi#OSI_PTR_NAME": "Public Test Realm"
    },
    "esES": {
      "osi#OSI_GAME_PASS_TOOLTIP": "La edición básica se incluye con Xbox Game Pass para los usuarios activos con una suscripción que hayan vinculado su cuenta de Battle.net a su cuenta de Xbox. Para acceder a Reign of the Warlock, es necesario comprarlo por separado.",
      "osi#OSI_PTR_NAME": "Reino público de pruebas"
    },
    "esMX": {
      "osi#OSI_GAME_PASS_TOOLTIP": "La edición base se incluye con Xbox Game Pass para los usuarios activos con una suscripción elegible que hayan vinculado su cuenta de Battle.net a su cuenta de Xbox. El acceso a Reign of the Warlock debe comprarse por separado.",
      "osi#OSI_PTR_NAME": "Reino público de pruebas"
    },
    "frFR": {
      "osi#OSI_GAME_PASS_TOOLTIP": "La Standard Edition est incluse dans le Xbox Game Pass pour les personnes disposant d’un abonnement valide et ayant associé leur compte Battle.net à leur compte Xbox. Le contenu téléchargeable Reign of the Warlock doit être acheté séparément.",
      "osi#OSI_PTR_NAME": "Royaume public de test"
    },
    "itIT": {
      "osi#OSI_GAME_PASS_TOOLTIP": "L'edizione base è inclusa con Xbox Game Pass per tutti gli utenti attivi che hanno collegato il proprio account Battle.net al proprio account Xbox. L'accesso a Reign of Warlock richiede un acquisto separato.",
      "osi#OSI_PTR_NAME": "Reame pubblico di prova"
    },
    "jaJP": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Xbox Game Passに加入していて、かつBattle.netアカウントとXboxアカウントをリンクしている方は、「Base Edition」をXbox Game Passの​​​​コンテンツと​​​​して​​​​プレイできます。「ウォーロック君臨」をプレイするには別途購入する必要があります。",
      "osi#OSI_NAME": "ディアブロⅡ",
      "osi#OSI_PTR_NAME": "パブリックテストサーバー"
    },
    "koKR": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Battle.net 계정과 Xbox 계정을 연결하고 적격 구독을 이용 중인 활성 사용자의 Xbox Game Pass에 기본 에디션이 포함되어 있습니다. 악마술사의 군림을 이용하려면 별도 구매가 필요합니다.",
      "osi#OSI_NAME": "디아블로 II: 레저렉션",
      "osi#OSI_PTR_NAME": "공개 테스트 서버"
    },
    "plPL": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Wersja Base Edition jest dostępna w subskrypcji Xbox Game Pass dla aktywnych użytkowników z kwalifikującą się subskrypcją, którzy powiązali konto Battle.net z kontem Xbox. Aby uzyskać dostęp do dodatku Reign of the Warlock, trzeba dokonać osobnego zakupu.",
      "osi#OSI_PTR_NAME": "Publiczny Serwer Testowy"
    },
    "ptBR": {
      "osi#OSI_GAME_PASS_TOOLTIP": "A edição-base está incluída no Xbox Game Pass para os usuários ativos com uma assinatura elegível que vincularam sua conta Battle.net à conta Xbox. O acesso a Reign of the Warlock requer uma compra separada.",
      "osi#OSI_PTR_NAME": "Reino de Teste Público"
    },
    "ruRU": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Базовая версия доступна обладателям действующей подписки Xbox Game Pass, объединившим учетные записи Battle.net и Xbox. Дополнение Reign of the Warlock приобретается отдельно.",
      "osi#OSI_PTR_NAME": "Тестовый игровой мир (PTR)"
    },
    "thTH": {
      "osi#OSI_GAME_PASS_TOOLTIP": "Base Edition รวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่มีการสมัครสมาชิกที่เข้าเงื่อนไขและได้เชื่อมบัญชี Battle.net® เข้ากับบัญชี Xbox ของตัวเองแล้ว การเข้าถึง Reign of the Warlock จำเป็นต้องซื้อแยกต่างหาก",
      "osi#OSI_PTR_NAME": "เซิร์ฟเวอร์ทดสอบสาธารณะ (PTR)"
    },
    "zhCN": {
      "osi#OSI_GAME_PASS_TOOLTIP": "基础版已加入 Xbox Game Pass，拥有有效订阅并将战网账号和 Xbox 账号绑定方可使用。访问‘术士君临’内容需另行购买。",
      "osi#OSI_NAME": "《暗黑破坏神2》重置版",
      "osi#OSI_PTR_NAME": "公共测试服"
    },
    "zhTW": {
      "osi#OSI_GAME_PASS_TOOLTIP": "已訂閱 Xbox Game Pass，且已將 Battle.net 帳號連結至其 Xbox 帳號的玩家將可遊玩基本版。《術士軍臨》需要另外購買。",
      "osi#OSI_NAME": "《暗黑破壞神®II：獄火重生》",
      "osi#OSI_PTR_NAME": "測試伺服器"
    }
  },
