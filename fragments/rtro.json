  "strings": {
    "deDE": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Die Blizzard Arcade Collection ist im Xbox Game Pass für aktive Benutzer der mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben.",
      "rtro#RTRO_NAME": "Blizzard Arcade-Sammlung"
    },
    "default": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Blizzard Arcade Collection is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account.",
      "rtro#RTRO_NAME": "Blizzard Arcade Collection",
      "rtro#RTRO_NAME_SHORT": "Blizzard Arcade"
    },
    "esES": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "La Colección arcade de Blizzard se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox.",
      "rtro#RTRO_NAME": "Colección arcade de Blizzard",
      "rtro#RTRO_NAME_SHORT": "Arcade de Blizzard"
    },
    "esMX": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "La Colección de Arcade de Blizzard se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox.",
      "rtro#RTRO_NAME": "Colección de arcade de Blizzard"
    },
    "frFR": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "La Blizzard Arcade Collection est incluse dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox."
    },
    "itIT": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "La Blizzard Arcade Collection è inclusa in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox."
    },
    "jaJP": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「ブリザード・アーケードコレクション」をXbox Game Passでお楽しみいただけます。",
      "rtro#RTRO_NAME": "Blizzard Arcade Collection（アーケードコレクション）",
      "rtro#RTRO_NAME_SHORT": "ブリザード・アーケード"
    },
    "koKR": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Blizzard® 아케이드 컬렉션은 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다.",
      "rtro#RTRO_NAME": "블리자드 아케이드 컬렉션",
      "rtro#RTRO_NAME_SHORT": "블리자드 아케이드"
    },
    "plPL": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Blizzard Arcade Collection jest dostępne w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox."
    },
    "ptBR": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "A Blizzard Arcade Collection está inclusa no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox.",
      "rtro#RTRO_NAME": "Coleção Arcade da Blizzard"
    },
    "ruRU": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Набор Blizzard Arcade Collection доступен активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox."
    },
    "thTH": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "Blizzard Arcade Collection จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox"
    },
    "zhCN": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩《Blizzard Arcade Collection》。"
    },
    "zhTW": {
      "rtro#RTRO_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩《暴雪遊樂場典藏系列》。",
      "rtro#RTRO_NAME": "《暴雪遊樂場典藏系列》",
      "rtro#RTRO_NAME_SHORT": "《暴雪遊樂場》"
    }
  },
