  "strings": {
    "deDE": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo ist im Xbox Game Pass für aktive Benutzer mit einem gültigen Abonnement enthalten, die ihren Battle.net-Account mit ihrem Xbox-Konto verknüpft haben."
    },
    "default": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo is included with Xbox Game Pass for active users with an eligible subscription who have linked their Battle.net account to their Xbox account.",
      "diablo_i#D1_NAME": "Diablo",
      "diablo_i#D1_NAME_HELLFIRE": "Hellfire"
    },
    "esES": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo se incluye en Xbox Game Pass para los usuarios activos que tengan una suscripción válida y hayan vinculado su cuenta de Battle.net a la de Xbox."
    },
    "esMX": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo se incluye en el Xbox Game Pass de los usuarios activos con una suscripción válida que hayan vinculado su cuenta de Battle.net con su cuenta de Xbox."
    },
    "frFR": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo est inclus dans le Xbox Game Pass pour les comptes actifs disposant d’un abonnement éligible et ayant associé leur compte Battle.net à leur compte Xbox."
    },
    "itIT": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo è incluso in Xbox Game Pass per gli utenti attivi con un abbonamento idoneo e un account Battle.net collegato all'account Xbox."
    },
    "jaJP": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Xbox Game Passに加入中で、対象となるサブスクリプションが有効であり、かつBattle.netとXboxのアカウントを連携している方は、「ディアブロ」をXbox Game Passでお楽しみいただけます。"
    },
    "koKR": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "디아블로는 유효한 구독권을 보유하고 Battle.net 계정을 Xbox 계정에 연동한 활성 사용자의 Xbox Game Pass에 포함됩니다"
    },
    "plPL": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo jest dostępne w ramach Xbox Game Pass dla wszystkich aktywnych użytkowników z odpowiednią subskrypcją, którzy połączyli swoje konto Battle.net z kontem Xbox."
    },
    "ptBR": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo está incluso no Xbox Game Pass para usuários ativos com uma assinatura elegível que tenham vinculado sua Conta Battle.net à conta Xbox."
    },
    "ruRU": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Игра Diablo доступна активным пользователям Xbox Game Pass с действующей подпиской, связавшим Battle.net с учетной записью сети Xbox."
    },
    "thTH": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "Diablo จะรวมอยู่ใน Xbox Game Pass สำหรับผู้ใช้ที่ใช้งานอยู่และมีการสมัครสมาชิกที่เป็นไปตามเงื่อนไขซึ่งได้เชื่อมโยงบัญชี Battle.net ไว้กับบัญชี Xbox"
    },
    "zhCN": {"diablo_i#D1_GAME_PASS_DISCLAIMER": "拥有有效Xbox Game Pass订阅并将战网通行证与Xbox账号绑定的活跃用户可免费游玩《暗黑破坏神》。"},
    "zhTW": {
      "diablo_i#D1_GAME_PASS_DISCLAIMER": "玩家只需要擁有符合條件的訂閱，再將 Battle.net 帳號連結至 Xbox 帳戶，即可藉由有效的 Xbox Game Pass 暢玩《暗黑破壞神》"
    }
  },
